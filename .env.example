# Server Environment (Use 0.0.0.0 for cloud/Docker deployments)
NODE_ENV=development
HOST=0.0.0.0
PORT=10000
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL=postgresql://zyvo_user:zyvo_password@127.0.0.1:5432/zyvo_dev?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Authentication (JWT)
JWT_ACCESS_SECRET=zyvo_super_secret_jwt_access_token_key_change_in_production
JWT_ACCESS_TTL=15m

# Security
CORS_ORIGIN=*
